{
    // As a GitHub organization admin, you can access the Renovate dashboard at
    // https://developer.mend.io/github/Lombiq and manage the GitHub app (including enabling it for new repos) at
    // https://github.com/organizations/Lombiq/settings/installations/58718719.
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    description: 'Default Lombiq Renovate configuration.',
    extends: [
        // See https://docs.renovatebot.com/presets-config/#configbest-practices.
        'config:best-practices',
    ],
    addLabels: [
        'dependencies',
        'renovate',
    ],
    dependencyDashboard: false,
    packageRules: [
        {
            groupName: 'Lombiq packages',
            matchPackageNames: [
                'Lombiq.*',
            ],
            allowedVersions: '!/.*-alpha.*/'
        },
        // Wait a bit with major and minor releases so if patches come out fixing bugs in them, we can instead update to
        // those right away. Patch updates won't be sent by Renovate instead of the major/minor ones, though, since it
        // can't do that: https://github.com/renovatebot/renovate/discussions/39472#discussioncomment-15078711. But at
        // least the pending patch update will be shown in the table under the PR.
        {
            matchUpdateTypes: ['major', 'minor'],
            minimumReleaseAge: '15 days',
        },
        {
            matchUpdateTypes: ['patch'],
            minimumReleaseAge: '0 days',
        },
        // While minor versions are supposed to be non-breaking too, those often require some more thought due to new
        // features that we might want to utilize.
        {
            groupName: 'Patch Dependency Versions',
            matchUpdateTypes: ['patch', 'pin', 'pinDigest'],
        },
        {
            groupName: 'Submodules',
            matchManagers: ['git-submodules'],
            // Even if the minimumReleaseAge is configured for other dependencies, submodules, since they don't have
            // release timestamps, should be updated right away.
            minimumReleaseAge: '0 days',
        },
    ],
    // With GitHub Actions, concurrency is not really an issue.
    prHourlyLimit: 0,
    // Note that prCreation: 'not-pending' is NOT needed, despite the Renovate docs recommending it, because it causes
    // no PRs to be created with `"prBlockedBy": "AwaitingTests",`. Keeping it on the default works as expected.
    // Without timestamp-optional, Renovate wouldn't update dependencies of package managers that don't provide
    // timestamps, like GitHub Actions and git-submodules.
    minimumReleaseAgeBehaviour: 'timestamp-optional',
    // Between 0:00 and 6:59 UTC on Sundays. Large time window to ensure that Renovate runs at least once then:
    // https://docs.renovatebot.com/configuration-options/#schedule.
    schedule: [
        '* 0-6 * * 7',
    ],
    'git-submodules': {
        enabled: true,
    },
    customManagers: [
        {
            depNameTemplate: 'NPM packages via Microsoft Library Manager (LibMan)',
            customType: 'jsonata',
            fileFormat: 'json',
            managerFilePatterns: [
                '/libman.json/',
            ],
            matchStrings: [
                'libraries[$contains(library, "/") = false].{ "packageName": $replace(library, /@.*/, ""), "currentValue": $replace(library, /.*@/, "") }',
            ],
            datasourceTemplate: 'npm',
        },
        {
            depNameTemplate: 'GitHub repository via Microsoft Library Manager (LibMan)',
            customType: 'regex',
            managerFilePatterns: [
                '/libman.json/',
            ],
            matchStrings: [
                '"library": "(?<depName>[^"@\/]+\/[^"@]+?)@(?<currentDigest>[^"]+?)"'
            ],
            currentValueTemplate: "master",
            packageNameTemplate: "https://github.com/{{{depName}}}",
            datasourceTemplate: 'git-refs'
        }
    ],
}

{
    // As a GitHub organization admin, you can access the Renovate dashboard at
    // https://developer.mend.io/github/Lombiq and manage the GitHub app (including enabling it for new repos) at
    // https://github.com/organizations/Lombiq/settings/installations/58718719.
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    description: 'Default Lombiq Renovate configuration.',
    extends: [
        'config:recommended',
        ':enableVulnerabilityAlerts',
        'docker:pinDigests',
        'helpers:pinGitHubActionDigests',
        ':pinDevDependencies'
    ],
    addLabels: [
        'dependencies',
        'renovate',
    ],
    // See https://docs.renovatebot.com/configuration-options/#configmigration. This always uses single quotes, so we
    // use those too.
    configMigration: true,
    dependencyDashboard: false,
    packageRules: [
        {
            groupName: 'Lombiq packages',
            matchPackageNames: [
                'Lombiq.*',
            ],
            allowedVersions: '!/.*-alpha.*/'
        },
        {
            groupName: 'Submodules',
            matchManagers: ['git-submodules']
        },
        // While minor versions are supposed to be non-breaking too, those often require some more thought due to new
        // features that we might want to utilize.
        {
            groupName: 'Patch Dependency Versions',
            matchUpdateTypes: ['patch', 'pin', 'pinDigest'],
        },
    ],
    // With GitHub Actions, concurrency is not really an issue.
    prHourlyLimit: 0,
    // Between 0:00 and 6:59 UTC on Sundays. Large time window to ensure that Renovate runs at least once then:
    // https://docs.renovatebot.com/configuration-options/#schedule.
    schedule: [
        '* 0-6 * * 7',
    ],
    'git-submodules': {
        enabled: true,
    },
    customManagers: [
        {
            depNameTemplate: 'NPM packages via Microsoft Library Manager (LibMan)',
            customType: 'jsonata',
            fileFormat: 'json',
            managerFilePatterns: [
                '/libman.json/',
            ],
            matchStrings: [
                'libraries[$contains(library, "/") = false].{ "packageName": $replace(library, /@.*/, ""), "currentValue": $replace(library, /.*@/, "") }',
            ],
            datasourceTemplate: 'npm',
        },
        {
            depNameTemplate: 'GitHub repository via Microsoft Library Manager (LibMan)',
            customType: 'regex',
            managerFilePatterns: [
                '/libman.json/',
            ],
            matchStrings: [
                '"library": "(?<depName>[^"@\/]+\/[^"@]+?)@(?<currentDigestShort>[^"]+?)"'
            ],
            currentValueTemplate: "master",
            packageNameTemplate: "https://github.com/{{{depName}}}",
            datasourceTemplate: 'git-refs'
        }
    ],
}
